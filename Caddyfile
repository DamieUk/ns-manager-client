# Serves the built SPA inside the container. Unknown paths fall back to index.html so
# react-router deep links (e.g. /clients/123) work on reload.
:80 {
	root * /srv

	# .htaccess is only for Apache/LiteSpeed hosting; don't serve dotfiles here.
	@dotfiles path /.*
	respond @dotfiles 404

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
